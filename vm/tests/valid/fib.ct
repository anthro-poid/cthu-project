structure fib
(
    rec = λ a b i → out
    (
        w₃₂   dup  b     → b₁ a'
        i₃₂   add  b₁ a  → b'

        i₃₂   cons_1     → one
        i₃₂   sub  i one → i'

        fib   loop               → cont
        fᵢᵢᵢⁱ call cont a' b' i' → out
    )

    base = λ a b i → out
    (
        w₃₂ drop a
        w₃₂ drop i
        w₃₂ move b → out
    )

    loop = λ a b i → out
    (
        i₃₂ cons_0      → zero
        w₃₂ dup i       → i₁ i₂
        i₃₂ le? i₁ zero → cmp

        bool dup cmp   → cmp₁ cmp₂
        bool not cmp₂  → cmp₃

        fib base  → base
        fib rec   → rec

        fᵢᵢᵢⁱ opt → opt₁
        f_b_f__f call opt₁ cmp₁ base → alt₁
        fᵢᵢᵢⁱ opt → opt₂
        f_b_f__f call opt₂ cmp₃ rec → alt₂

        fᵢᵢᵢⁱ join → join
        f_f_f__f call join alt₁ alt₂ → cont
        fᵢᵢᵢⁱ call cont a b i₂     → out
    )

    compute = λ in → out
    (
        i₃₂  cons_1    → a ; construct 1 on stack $a
        i₃₂  cons_1    → b ; construct 1 on stack $b
        i₃₂  cons_2    → x ; construct 2 on stack $x

        i₃₂  sub  in x → i

        fib   loop            → cont
        fᵢᵢᵢⁱ call cont a b i → out
    )
)

structure main
(
    run = λ
    (
        i₃₂ cons_1 → a
        fib compute        → program
        fᵢⁱ call program a → out
        i₃₂ cons_1   → b
        i₃₂ eq?  out b → c
        bool assert c

        i₃₂ cons_2 → a
        fib compute        → program
        fᵢⁱ call program a → out
        i₃₂ cons_1   → b
        i₃₂ eq?  out b → c
        bool assert c

        i₃₂ cons_3 → a
        fib compute        → program
        fᵢⁱ call program a → out
        i₃₂ cons_2   → b
        i₃₂ eq?  out b → c
        bool assert c

        i₃₂ cons_4 → a
        fib compute        → program
        fᵢⁱ call program a → out
        i₃₂ cons_3   → b
        i₃₂ eq?  out b → c
        bool assert c

        i₃₂ cons_5 → a
        fib compute        → program
        fᵢⁱ call program a → out
        i₃₂ cons_5   → b
        i₃₂ eq?  out b → c
        bool assert c

        i₃₂ cons_6 → a
        fib compute        → program
        fᵢⁱ call program a → out
        i₃₂ cons_8   → b
        i₃₂ eq?  out b → c
        bool assert c

        i₃₂ cons_7 → a
        fib compute        → program
        fᵢⁱ call program a → out
        i₃₂ cons_13   → b
        i₃₂ eq?  out b → c
        bool assert c
    )
)
