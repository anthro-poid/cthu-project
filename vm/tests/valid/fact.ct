structure fact
(
    rec = λ a i → out
    (
        w₃₂   dup  i     → i1 i2
        i₃₂   mul  a  i1 →  a'

        i₃₂   cons_1     → one
        i₃₂   sub  i2 one → i'

        fact loop            → cont
        fᵢᵢⁱ call cont a' i' → out
    )

    base = λ a i → out
    (
        w₃₂ drop i
        w₃₂ move a → out
    )

    loop = λ a i → out
    (
        i₃₂ cons_0      → zero
        w₃₂ dup i       → i₁ i₂
        i₃₂ le? i₁ zero → cmp

        bool dup cmp   → cmp₁ cmp₂
        bool not cmp₂  → cmp₃

        fact base  → base
        fact rec   → rec

        fᵢᵢⁱ opt → opt₁
        f_b_f__f call opt₁ cmp₁ base → alt₁
        fᵢᵢⁱ opt → opt₂
        f_b_f__f call opt₂ cmp₃ rec → alt₂

        fᵢᵢⁱ join → join
        f_f_f__f call join alt₁ alt₂ → cont
        fᵢᵢⁱ call cont a i₂     → out
    )

    compute = λ in → out
    (
        i₃₂ cons_1 → a
        fact loop → cont
        fᵢᵢⁱ call cont a in → out
    )
)

structure main
(
    run = λ
    (
        i₃₂ cons_0 → a
        fact compute        → program
        fᵢⁱ call program a → out
        i₃₂ cons_1   → b
        i₃₂ eq?  out b → c
        bool assert c

        i₃₂ cons_1 → a
        fact compute        → program
        fᵢⁱ call program a → out
        i₃₂ cons_1   → b
        i₃₂ eq?  out b → c
        bool assert c

        i₃₂ cons_2 → a
        fact compute        → program
        fᵢⁱ call program a → out
        i₃₂ cons_2   → b
        i₃₂ eq?  out b → c
        bool assert c

        i₃₂ cons_3 → a
        fact compute        → program
        fᵢⁱ call program a → out
        i₃₂ cons_6   → b
        i₃₂ eq?  out b → c
        bool assert c
    )
)
