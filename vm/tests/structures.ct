structure f : f₀⁰[ func, stck, bool ]
(
    fork = builtin_func_fork ; linear
    move = builtin_func_move ; linear
    push = builtin_func_push ; linear
    pop  = builtin_func_pop  ; linear
    drop = builtin_func_drop ; affine
    dup  = builtin_func_dup  ; simple
    call = builtin_func_call ; f₀⁰

    f_bot = λ ∅ → ∅ ()
    f_top = λ ∅ → ∅ ()

    bot = λ ∅ → out
    (
        f f_bot -> out
    )

    top = λ ∅ → out
    (
        f f_top -> out
    )

    frame = λ A B
    (
        f call A
        f call B
    )

    join = λ a b → out
    (
        f frame -> frame
        lambda bind frame a -> x
        lambda bind x b -> out
    )

    opt = λ a b → out
    (
        f f_bot -> bot
        lambda select a b bot -> out
    )
)

structure fᵢⁱ : f₁¹[ func, stck, bool, w₃₂, w₃₂ ]
(
    fork = builtin_func_fork ; linear
    move = builtin_func_move ; linear
    push = builtin_func_push ; linear
    pop  = builtin_func_pop  ; linear
    drop = builtin_func_drop ; affine
    dup  = builtin_func_dup  ; simple
    call = builtin_func_call ; f₁¹

    f_bot = λ a → b
    (
        w₃₂ drop a
        w₃₂ bot -> b
    )

    f_top = λ a → b
    (
        w₃₂ drop a
        w₃₂ top -> b
    )

    bot = λ ∅ → out
    (
        fᵢⁱ f_bot -> out
    )

    top = λ ∅ → out
    (
        fᵢⁱ f_top -> out
    )

    frame = λ A B a → out
    (
        w₃₂ fork a -> a₁ a₂
        fᵢⁱ call A a₁ -> out₁
        fᵢⁱ call B a₂ -> out₂
        w₃₂ join out₁ out₂ -> out
    )

    join = λ a b → out
    (
        fᵢⁱ frame -> frame
        lambda bind frame a -> x
        lambda bind x b -> out
    )

    opt = λ a b → out
    (
        fᵢⁱ f_bot -> bot
        lambda select a b bot -> out
    )
)

structure fᵢᵢⁱ : f₂¹[ func, stck, bool, w₃₂, w₃₂, w₃₂ ]
(
    fork = builtin_func_fork ; linear
    move = builtin_func_move ; linear
    push = builtin_func_push ; linear
    pop  = builtin_func_pop  ; linear
    drop = builtin_func_drop ; affine
    dup  = builtin_func_dup  ; simple
    call = builtin_func_call ; f₂¹

    f_bot = λ a b → c
    (
        w₃₂ drop a
        w₃₂ drop b
        w₃₂ bot -> c
    )

    f_top = λ a b → c
    (
        w₃₂ drop a
        w₃₂ drop b
        w₃₂ top -> c
    )

    bot = λ ∅ → out
    (
        fᵢᵢⁱ f_bot -> out
    )

    top = λ ∅ → out
    (
        fᵢᵢⁱ f_top -> out
    )

    frame = λ A B a b → out
    (
        w₃₂ fork a -> a₁ a₂
        w₃₂ fork b -> b₁ b₂
        fᵢᵢⁱ call A a₁ b₁ -> out₁
        fᵢᵢⁱ call B a₂ b₂ -> out₂
        w₃₂ join out₁ out₂ -> out
    )

    join = λ a b → out
    (
        fᵢᵢⁱ frame -> frame
        lambda bind frame a -> x
        lambda bind x b -> out
    )

    opt = λ a b → out
    (
        fᵢᵢⁱ f_bot -> bot
        lambda select a b bot -> out
    )
)

structure fᵢᵢᵢⁱ : f₃¹[ func, stck, bool, w₃₂, w₃₂, w₃₂, w₃₂ ]
(
    fork = builtin_func_fork ; linear
    move = builtin_func_move ; linear
    push = builtin_func_push ; linear
    pop  = builtin_func_pop  ; linear
    drop = builtin_func_drop ; affine
    dup  = builtin_func_dup  ; simple
    call = builtin_func_call ; f₃¹

    f_bot = λ a b c → d
    (
        w₃₂ drop a
        w₃₂ drop b
        w₃₂ drop c
        w₃₂ bot -> d
    )

    f_top = λ a b c → d
    (
        w₃₂ drop a
        w₃₂ drop b
        w₃₂ drop c
        w₃₂ top -> d
    )

    bot = λ ∅ → out
    (
        fᵢᵢᵢⁱ f_bot -> out
    )

    top = λ ∅ → out
    (
        fᵢᵢᵢⁱ f_top -> out
    )

    frame = λ A B a b c → out
    (
        w₃₂ fork a -> a₁ a₂
        w₃₂ fork b -> b₁ b₂
        w₃₂ fork c -> c₁ c₂
        fᵢᵢᵢⁱ call A a₁ b₁ c₁ -> out₁
        fᵢᵢᵢⁱ call B a₂ b₂ c₂ -> out₂
        w₃₂ join out₁ out₂ -> out
    )

    join = λ a b → out
    (
        fᵢᵢᵢⁱ frame -> frame
        lambda bind frame a -> x
        lambda bind x b -> out
    )

    opt = λ a b → out
    (
        fᵢᵢᵢⁱ f_bot -> bot
        lambda select a b bot -> out
    )
)
